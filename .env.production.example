# Hamper Queen — production / deployment environment TEMPLATE (safe to commit).
# Copy to .env.production, fill in, then paste the values into your host's
# environment settings. Full guide: docs/ENVIRONMENT.md ("Deployment environment").

# REQUIRED — Atlas connection string (URL-encode special chars in the password).
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=HamperQueen

# REQUIRED — database name (default: hamper_queen).
MONGODB_DB=hamper_queen

# REQUIRED in production — public origin, e.g. https://www.example.com
HQ_BASE_URL=https://your-domain.example

# OPTIONAL — SRV-DNS fallback shard hosts (comma-separated).
# MONGODB_DIRECT_HOSTS=ac-xxxx-shard-00-00.xxxx.mongodb.net:27017,ac-xxxx-shard-00-01.xxxx.mongodb.net:27017
