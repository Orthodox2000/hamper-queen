# =============================================================================
# Hamper Queen — environment template
# -----------------------------------------------------------------------------
# Fastest path:   npm run setup          (creates .env for you, local MongoDB)
# Manual path:    cp .env.example .env   and edit the values below.
# `.env*` is gitignored — never commit real credentials.
# Full guide: docs/ENVIRONMENT.md
# =============================================================================

# --- Database (REQUIRED at runtime) ------------------------------------------
# Local development (docker compose up -d mongo  ->  `npm run db:up`):
MONGODB_URI=mongodb://127.0.0.1:27017/
# MongoDB Atlas (production) — URL-encode special characters in the password:
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=HamperQueen

# Database name used by the app and every script (default: hamper_queen).
# Use a different name per environment, e.g. hamper_queen_dev / hamper_queen_staging.
# MONGODB_DB=hamper_queen

# Only needed if your network blocks the SRV DNS lookup behind mongodb+srv://
# and you moved to a new Atlas cluster. Comma-separated shard hosts.
# MONGODB_DIRECT_HOSTS=ac-xxxx-shard-00-00.xxxx.mongodb.net:27017,ac-xxxx-shard-00-01.xxxx.mongodb.net:27017

# --- Site ---------------------------------------------------------------------
# Public origin, used for sitemap / OpenGraph / tracking links.
HQ_BASE_URL=http://localhost:3000

# --- First owner admin (bootstrap-only) --------------------------------------
# Read ONLY by `npm run db:bootstrap` / `npm run db:setup`. After the owner is
# created the password line is commented out automatically. When omitted the
# script prompts interactively. Minimum 8 characters.
HQ_BOOTSTRAP_ADMIN_USER=owner
# HQ_BOOTSTRAP_ADMIN_PASSWORD=change-me-please
