# Hamper Queen environment template.
# Copy to `.env` and fill in. `.env*` is gitignored — never commit real credentials.

# Required at runtime.
MONGODB_URI=mongodb+srv://<user>:<db_password>@cluster0.jma7vfa.mongodb.net/?appName=Cluster0

# Optional — bootstrap-only. Used ONLY by `npm run db:bootstrap` to create the
# first owner admin. When omitted, the script prompts interactively.
# HQ_BOOTSTRAP_ADMIN_USER=superadmin
# HQ_BOOTSTRAP_ADMIN_PASSWORD=change-me