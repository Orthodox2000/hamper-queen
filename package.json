{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "next dev -p 3000 --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "tsc --noEmit",
    "db:test": "node --env-file=.env scripts/test-mongo.mjs",
    "db:bootstrap": "node --env-file=.env scripts/bootstrap-db.mjs",
    "db:reset-admin": "node --env-file=.env scripts/reset-admin.mjs",
    "db:test-promo": "node --env-file=.env scripts/test-promo.mjs",
    "setup": "node scripts/setup-env.mjs",
    "db:up": "docker compose up -d mongo",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f mongo",
    "db:setup": "node scripts/setup-env.mjs --if-missing && node --env-file=.env scripts/bootstrap-db.mjs",
    "check:ssr": "node scripts/ssr-check.mjs",
    "icons": "python3 scripts/generate-icons.py"
  },
  "dependencies": {
    "@fontsource-variable/dancing-script": "^5.3.0",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/canvas-confetti": "^1.9.0",
    "canvas-confetti": "^1.9.4",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.546.0",
    "mongodb": "^7.6.0",
    "motion": "^12.23.24",
    "next": "^16.3.5",
    "postcss": "^8.5.28",
    "react": "^19.0.1",
    "react-dom": "^19.0.1"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  },
  "browserslist": [
    "chrome >= 111",
    "edge >= 111",
    "firefox >= 128",
    "safari >= 16.4",
    "ios_saf >= 16.4",
    "not dead"
  ]
